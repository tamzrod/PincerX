{
  "name": "pincerx",
  "version": "1.0.0",
  "description": "A local creative storytelling system with character tracking, lore management, and multi-voice TTS narration",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "test": "jest --coverage --verbose",
    "test:report": "jest --coverage --verbose --coverageReporters=text --coverageReporters=json-summary"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "lib/**/*.js",
      "api/**/*.js",
      "story/**/*.js"
    ]
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
