# ─────────────────────────────────────────────
# PincerX – environment variable examples
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── Local mode (Ollama running on host) ──────
# AI_BASE_URL=http://host.docker.internal:11434
# AI_MODEL=llama3
# AI_API_KEY=

# ── Stack mode (Ollama in Docker) ────────────
# AI_BASE_URL=http://ollama:11434
# AI_MODEL=llama3
# AI_API_KEY=

# ── Cloud LLM mode (OpenAI-compatible API) ───
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o
# AI_API_KEY=sk-your-api-key-here
