# ─────────────────────────────────────────────
# PincerX – environment variable examples
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── Local mode (Ollama running on host) ──────
# AI_BASE_URL=http://host.docker.internal:11434
# AI_MODEL=llama3.2
# AI_API_KEY=

# ── Stack mode (Ollama in Docker) ────────────
# AI_BASE_URL=http://ollama:11434
# AI_MODEL=llama3.2
# AI_API_KEY=

# ── Cloud LLM mode (OpenAI-compatible API) ───
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o
# AI_API_KEY=sk-your-api-key-here

# ── Zonos TTS sidecar (optional, requires GPU) ─
# ZONOS_URL=http://zonos:8000   ← when using docker-compose.zonos.yml
# ZONOS_URL=http://localhost:8000  ← when running Zonos directly on the host
# Leave unset to have the /tts endpoint fall back to a 502 (browser TTS is used instead)

# ── Hugging Face token (optional but recommended) ───
# Avoids throttled / interrupted model downloads from Hugging Face.
# Get a free token at https://huggingface.co/settings/tokens (no credit card needed).
# HF_TOKEN=hf_your_token_here
